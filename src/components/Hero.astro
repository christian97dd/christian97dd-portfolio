---
import ExternalLink from './ExternalLink.astro';
import LanguageToggle from './LanguageToggle.astro';
import { links } from '../data/links';
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<header class="hero" data-hero>
  <canvas data-lantern aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="topbar">
      <p class="handle">{t.hero.handle}</p>
      <LanguageToggle />
    </div>
    <h1>
      {t.hero.firstName}<br />{t.hero.lastNamePrefix} <em>{t.hero.lastName}</em>
    </h1>
    <p class="thesis">{t.hero.thesisLead} <span>{t.hero.thesisRest}</span></p>
    <nav class="profiles" aria-label={t.a11y.profilesNav}>
      <ul>
        <li><ExternalLink href={links.github}>{t.links.github}</ExternalLink></li>
        <li><ExternalLink href={links.linkedin}>{t.links.linkedin}</ExternalLink></li>
        <li><ExternalLink href={links.itch}>{t.links.itch}</ExternalLink></li>
        <li><a href="#taller">{t.links.workshop}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hero {
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
    padding: 32px var(--gutter) 88px;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .wrap {
    position: relative;
    display: grid;
    gap: 28px;
  }

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .handle {
    margin: 0;
    font: 500 13px/1 var(--mono);
    letter-spacing: 0.08em;
    color: var(--ember);
  }

  h1 {
    margin: 0;
    font: 400 clamp(52px, 11vw, 132px)/0.92 var(--display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    color: var(--ember);
  }

  .thesis {
    margin: 0;
    max-width: 34ch;
    font: 400 clamp(20px, 2.6vw, 26px)/1.35 var(--display);
  }

  .thesis span {
    color: var(--muted);
  }

  .profiles ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 14px/1 var(--mono);
  }

  .profiles :global(a) {
    display: inline-block;
    padding-block: 6px;
    text-decoration: none;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    transition: color 0.2s, border-color 0.2s;
  }

  .profiles :global(a:hover) {
    color: var(--bone);
    border-color: var(--ember);
  }
</style>
